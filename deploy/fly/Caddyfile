:8080 {
	@unauthorized expression `{http.request.uri.path} != "/healthz" && {http.request.header.Authorization} != "Bearer {$MINNOW_TOKEN}"`
	respond @unauthorized 401

	reverse_proxy 127.0.0.1:8081 {
		# Minnow listens on loopback, and the MCP SDK rejects a non-loopback Host
		# on a loopback listener as DNS rebinding.
		header_up Host {upstream_hostport}
	}
}
